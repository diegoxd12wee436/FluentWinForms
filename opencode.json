{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "git push *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny"
    }
  }
}